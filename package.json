{
  "name": "ali-oss-server-workspace",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @ali-oss-server/server --filter @ali-oss-server/admin dev",
    "build": "pnpm --filter @ali-oss-server/admin build && pnpm --filter @ali-oss-server/server build",
    "typecheck": "pnpm --filter @ali-oss-server/admin typecheck && pnpm --filter @ali-oss-server/server typecheck",
    "start": "pnpm --filter @ali-oss-server/server start"
  }
}
