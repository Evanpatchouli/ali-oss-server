{
  "name": "ali-oss-server-workspace",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "homepage": "https://github.com/Evanpatchouli/ali-oss-server",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @ali-oss-server/server --filter @ali-oss-server/admin dev",
    "build:sdk": "pnpm --filter @ali-oss-server/sdk build",
    "build:admin": "pnpm --filter @ali-oss-server/admin build",
    "build:app": "pnpm --filter @ali-oss-server/admin build && pnpm --filter @ali-oss-server/server build",
    "build": "pnpm --filter @ali-oss-server/sdk build && pnpm --filter @ali-oss-server/admin build && pnpm --filter @ali-oss-server/server build",
    "typecheck": "pnpm --filter @ali-oss-server/sdk typecheck && pnpm --filter @ali-oss-server/admin typecheck && pnpm --filter @ali-oss-server/server typecheck",
    "start": "pnpm --filter @ali-oss-server/server start",
    "version:app": "node scripts/bump-app-version.mjs",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "devDependencies": {
    "prettier": "^3.9.4"
  }
}
