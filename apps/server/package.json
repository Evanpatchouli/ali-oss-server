{
  "name": "@ali-oss-server/server",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:ts": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:protocol": "node --import tsx --test test/file-name-header.test.mjs",
    "test:contract": "node --import tsx --test test/oss-object-contract.test.mjs"
  },
  "dependencies": {
    "@koa/router": "^15.6.0",
    "ali-oss": "^6.23.0",
    "dotenv": "^17.4.2",
    "koa": "^3.2.1",
    "koa-body": "^8.0.0",
    "koa-send": "^5.0.1"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/koa": "^3.0.3",
    "@types/koa__router": "^12.0.5",
    "@types/koa-send": "^4.1.6",
    "@types/node": "^26.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
