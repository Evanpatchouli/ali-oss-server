PORT=9512

# Multiple API callers can be configured here. Each caller has a dedicated clientId/clientSecret pair.
AUTH_CLIENTS=[{"clientId":"demo-client","clientSecret":"demo-secret"}]
TOKEN_SECRET=please-change-this-token-secret
TOKEN_EXPIRES_IN_SECONDS=7200
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-this-admin-password

OSS_REGION=oss-cn-hangzhou
OSS_BUCKET_NAME=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_SECURE=true
UPLOAD_MAX_FILE_SIZE_MB=20
