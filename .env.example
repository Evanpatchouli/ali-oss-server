PORT=9512

TOKEN_SECRET=please-change-this-token-secret
TOKEN_EXPIRES_IN_SECONDS=7200
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-this-admin-password

# Buckets share the credentials below. The first entry is the default bucket.
OSS_BUCKETS='[{"name":"your-bucket-name","region":"oss-cn-hangzhou"}]'
# Legacy single-bucket configuration is used only when OSS_BUCKETS is absent:
# OSS_REGION=oss-cn-hangzhou
# OSS_BUCKET_NAME=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_SECURE=true
UPLOAD_MAX_FILE_SIZE_MB=20
